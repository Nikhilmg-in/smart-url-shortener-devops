#!/bin/sh
# Managed by Ansible - (re)starts the Smart URL Shortener
cd {{ app_dir }}

if [ -f app.pid ] && kill -0 "$(cat app.pid)" 2>/dev/null; then
  kill "$(cat app.pid)"
  sleep 1
fi

APP_ENV={{ app_env }} nohup {{ app_dir }}/venv/bin/uvicorn main:app \
  --host 0.0.0.0 --port {{ app_port }} > app.log 2>&1 < /dev/null &
echo $! > app.pid
